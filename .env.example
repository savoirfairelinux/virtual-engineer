# Virtual Engineer — environment configuration
# Copy to .env and fill in your values.
#
# All provider configuration is managed from the admin UI 
# at http://127.0.0.1:3100/admin after startup.

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_PATH=./data/virtual-engineer.db
# Optional override. Setup creates a keyring under
# ${XDG_CONFIG_HOME:-$HOME/.config}/virtual-engineer when unset, then stores its
# path here. Normal startup reuses that path and never replaces the keyring.
# For an existing keyring, use an absolute path outside DATA_DIR and BACKUP_DIR;
# this .env parser does not expand ~ or $HOME. Never put raw key material here.
# Setup, recovery, and rotation: README.md, "Backups and recovery".
# BACKUP_KEYRING_FILE=/secure/path/backup-keyring.json
ADMIN_API_ENABLED=true
# Keep the Admin UI on loopback unless it is behind a trusted reverse proxy.
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=3100
# Required before creating or loading provider credentials. Setup and the
# normal Docker launcher generate and store it when unset; keep it stable.
# Newly generated values can be explicitly revealed to the first admin.
# Direct `npm run dev` runs need this value configured explicitly.
# Generate with: openssl rand -hex 32
# ADMIN_AUTH_SECRET=<generated-64-character-hex-value>

# ─── Workflow ─────────────────────────────────────────────────────────────────
# Polling interval, max agent cycles, and max retry attempts are now managed from
# the admin UI (Configuration → System Settings) and persisted in the database.
AGENT_TIMEOUT_MS=1800000

# ─── Agent sandbox ───────────────────────────────────────────────────────────
AGENT_CONTAINER_IMAGE=virtual-engineer-workspace:latest
WORKSPACE_BASE_DIR=/tmp/virtual-engineer/workspaces

# Shared RAM-backed limit for review diff fetches in scripts/start.sh.
# Positive integer with m (MiB) or g (GiB); changing it requires rerunning start.sh.
REVIEW_DIFF_TMPFS_SIZE=2g

# ─── OpenShell OIDC ──────────────────────────────────────────────────────────
# OpenShell always owns sandbox execution. Its Docker compute driver is the
# default; set kubernetes only to exercise the experimental k3s/Helm path.
OPENSHELL_COMPUTE_DRIVER=docker
# Leave issuer and secret empty to let scripts/start.sh deploy a managed local
# Keycloak. To use an external provider, set both values together and keep the
# filled .env local and uncommitted.
# Managed local OpenShell/Keycloak bootstrap state is kept outside the checkout
# by default so deleting and reinstalling the repository preserves its secret.
# Override this path when multiple local VE instances share the same user.
# OPENSHELL_STATE_DIR=
OPENSHELL_OIDC_ISSUER=
OPENSHELL_OIDC_CLIENT_ID=openshell-ci
OPENSHELL_OIDC_CLIENT_SECRET=
OPENSHELL_OIDC_AUDIENCE=openshell-cli
