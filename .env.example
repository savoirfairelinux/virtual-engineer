# Virtual Engineer environment. Copy to .env and keep it private.
# Configure provider credentials in the Admin UI after startup.

# Application
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_PATH=./data/virtual-engineer.db
# Leave blank for start.sh to generate/reuse the default keyring. An override
# must be outside DATA_DIR and BACKUP_DIR; never put key bytes here.
# Recovery and rotation: README.md, "Backups and recovery".
BACKUP_KEYRING_FILE=
ADMIN_API_ENABLED=true
# Keep the Admin UI on loopback unless behind a trusted reverse proxy.
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=3100
# start.sh generates this on a fresh instance; keep it stable. Direct runs and
# Kubernetes deployments must set it. Generate with: openssl rand -hex 32
ADMIN_AUTH_SECRET=

# Workflow: initial seed; manage live settings in Admin UI → System Settings.
AGENT_TIMEOUT_MS=1800000

# Agent sandbox
AGENT_CONTAINER_IMAGE=virtual-engineer-workspace:latest
WORKSPACE_BASE_DIR=/tmp/virtual-engineer/workspaces

# RAM limit for review diffs, e.g. 512m or 2g. Changes require rerunning start.sh.
REVIEW_DIFF_TMPFS_SIZE=2g

# OpenShell OIDC
# Docker is the default compute driver; kubernetes is experimental.
OPENSHELL_COMPUTE_DRIVER=docker
# Leave issuer and client secret blank for managed Keycloak; set both for external OIDC.
OPENSHELL_OIDC_ISSUER=
OPENSHELL_OIDC_CLIENT_ID=openshell-ci
OPENSHELL_OIDC_CLIENT_SECRET=
OPENSHELL_OIDC_AUDIENCE=openshell-cli
# Managed state stays outside the checkout. Set this only to use a separate location.
# OPENSHELL_STATE_DIR=
