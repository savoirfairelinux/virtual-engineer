FROM node:24-bookworm-slim

# Suppress interactive prompts from apt-get and npm
ENV DEBIAN_FRONTEND=noninteractive
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# Install required tools: git, SSH client, GitHub CLI, curl, jq
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    curl \
    ca-certificates \
    jq \
  && rm -rf /var/lib/apt/lists/*

# Install Python 3 + Aider (https://aider.chat) for the `aider` agent provider.
# Aider wraps any LLM backend via litellm; it is installed as an isolated uv tool
# so its dependencies don't clash with the Node toolchain. The binary is symlinked
# onto /usr/local/bin so the agent-worker subprocess spawn resolves it on PATH.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
  && rm -rf /var/lib/apt/lists/* \
  && curl -LsSf https://astral.sh/uv/install.sh | UV_VERSION=0.11.30 sh \
  && /root/.local/bin/uv tool install --python python3 aider-chat==0.86.2 \
  && ln -s /root/.local/bin/aider /usr/local/bin/aider
ENV PATH="/root/.local/bin:${PATH}"

# Install Goose CLI (https://goose-docs.ai) for the `goose` agent provider.
# Goose is a Rust CLI from the AAIF that wraps any LLM provider. It is installed
# via the official installer with a pinned version for reproducible builds. The
# binary lands in /usr/local/bin so the agent-worker subprocess spawn resolves it
# on PATH. CONFIGURE=false skips the interactive `goose configure` flow; the
# agent-worker writes the config.yaml into the HOME volume at runtime. bzip2 is
# required because the installer downloads a .tar.bz2 release archive; libxcb1
# provides libxcb.so.1, a shared library the goose binary links against.
#
# The installer script is pinned to the v1.21.1 release tag (not the `stable`
# channel) so the script itself is immutable and builds are reproducible.
RUN apt-get update && apt-get install -y --no-install-recommends bzip2 libxcb1 \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL https://github.com/aaif-goose/goose/releases/download/v1.21.1/download_cli.sh \
    | GOOSE_VERSION=1.21.1 CONFIGURE=false GOOSE_BIN_DIR=/usr/local/bin bash
# Default SSH config — accepts unknown host keys as a fallback for ephemeral
# containers. When sshKnownHostsPath is configured on the Gerrit integration,
# dockerVolume.ts overrides GIT_SSH_COMMAND at runtime with strict checking.
RUN mkdir -p ~/.ssh && printf '%s\n' "Host gerrit" "  StrictHostKeyChecking=no" "  UserKnownHostsFile=/dev/null" > ~/.ssh/config

# Install GitHub CLI
# Default GIT_SSH_COMMAND — overridden at runtime by dockerVolume.ts when
# sshKeyPath (and optionally sshKnownHostsPath) are configured.
ENV GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# Copy the agent worker, install all deps (including esbuild), build, then prune dev deps
COPY agent-worker/ /agent-worker/
RUN npm --prefix /agent-worker ci --no-fund \
  && npm --prefix /agent-worker run build \
  && npm --prefix /agent-worker prune --omit=dev --no-fund

# Set working directory
WORKDIR /workspace

# Default shell
CMD ["/bin/bash"]
