FROM node:24-bookworm-slim

# Suppress interactive prompts from apt-get and npm
ENV DEBIAN_FRONTEND=noninteractive
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# Install required tools: git, SSH client, GitHub CLI, curl, jq.
# iproute2 provides the `ip` binary the OpenShell supervisor needs to create the
# sandbox network namespace (proxy-mode isolation); without it the sandbox agent
# container crash-loops with "trusted ip helper not found".
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    curl \
    ca-certificates \
    jq \
    iproute2 \
  && rm -rf /var/lib/apt/lists/*
RUN groupadd --system sandbox \
  && useradd --system --gid sandbox --create-home \
    --home-dir /sandbox --shell /bin/bash sandbox

# Install Python 3 + Aider (https://aider.chat) for the `aider` agent provider.
# Aider wraps any LLM backend via litellm; it is installed as an isolated uv tool
# so its dependencies don't clash with the Node toolchain. The binary is symlinked
# onto /usr/local/bin so the agent-worker subprocess spawn resolves it on PATH.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
  && rm -rf /var/lib/apt/lists/* \
  && curl -LsSf https://astral.sh/uv/install.sh | UV_VERSION=0.11.30 sh \
  && /root/.local/bin/uv tool install --python python3 aider-chat==0.86.2 \
  && ln -s /root/.local/bin/aider /usr/local/bin/aider
ENV PATH="/root/.local/bin:${PATH}"

# Install Goose CLI (https://goose-docs.ai) for the `goose` agent provider.
# Goose is a Rust CLI from the AAIF that wraps any LLM provider. It is installed
# via the official installer with a pinned version for reproducible builds. The
# binary lands in /usr/local/bin so the agent-worker subprocess spawn resolves it
# on PATH. CONFIGURE=false skips the interactive `goose configure` flow; the
# agent-worker writes the config.yaml into the HOME volume at runtime. bzip2 is
# required because the installer downloads a .tar.bz2 release archive; libxcb1
# provides libxcb.so.1, a shared library the goose binary links against.
#
# The installer script is pinned to the v1.21.1 release tag (not the `stable`
# channel) so the script itself is immutable and builds are reproducible.
RUN apt-get update && apt-get install -y --no-install-recommends bzip2 libxcb1 \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL https://github.com/aaif-goose/goose/releases/download/v1.21.1/download_cli.sh \
    | GOOSE_VERSION=1.21.1 CONFIGURE=false GOOSE_BIN_DIR=/usr/local/bin bash

# Install the Codex CLI (https://github.com/openai/codex) for the `codex` agent
# provider. Codex is a standalone Rust binary distributed as an npm package; the
# global npm bin directory is already on PATH for the node:24-bookworm-slim base
# image, so no extra symlink step is needed. `NPM_CONFIG_UPDATE_NOTIFIER=false`
# (set above) suppresses the interactive update banner during CI builds.
RUN npm install -g @openai/codex

# Install the Gemini CLI (https://github.com/google-gemini/gemini-cli) for the
# `gemini` agent provider. Gemini CLI is a Node package; the global npm bin
# directory is already on PATH, so no extra symlink step is needed.
RUN npm install -g @google/gemini-cli
# Default SSH config — accepts unknown host keys as a fallback for ephemeral
# sandboxes. When sshKnownHostsPath is configured on the Gerrit integration,
# host-side git (HostGitExecutor / buildGitEnv) overrides GIT_SSH_COMMAND with
# strict checking for the push that runs in the orchestrator.
RUN mkdir -p ~/.ssh && printf '%s\n' "Host gerrit" "  StrictHostKeyChecking=no" "  UserKnownHostsFile=/dev/null" > ~/.ssh/config

# Install GitHub CLI
# Default GIT_SSH_COMMAND — host-side git overrides it when sshKeyPath
# (and optionally sshKnownHostsPath) are configured.
ENV GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# Keep the runtime under /app, which OpenShell's default filesystem policy
# permits as read-only executable content.
COPY agent-worker/ /app/agent-worker/
RUN npm --prefix /app/agent-worker ci --no-fund \
  && npm --prefix /app/agent-worker run build \
  && npm --prefix /app/agent-worker prune --omit=dev --no-fund

# Set working directory. The OpenShell sandbox overrides the working directory
# to `/sandbox` (its writable dir under the default policy); this WORKDIR is only
# a fallback for non-OpenShell invocations.
WORKDIR /workspace

# Default shell
CMD ["/bin/bash"]
