    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "virtual-engineer",
      "extra-files": [
        {
          "type": "json",
          "path": "agent-worker/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "agent-worker/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "agent-worker/package-lock.json",
